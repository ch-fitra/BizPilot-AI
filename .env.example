# ============================================================
# BizPilot AI — Environment Variables Template
# ============================================================
# Copy this file to .env for local development.
# NEVER commit a real .env file to version control.
# ============================================================

# --- AI Engine ---
# Required for AI Analyzer, AI Business Chat, and AI Forecast narratives.
# If omitted, the app runs in AI Disabled / Limited mode.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIM=768

# --- Auth ---
# Required for production JWT auth. Use at least 32 random characters.
# If omitted locally, server uses a runtime-only fallback (sessions reset on restart).
JWT_SECRET=your_random_32_char_secret_here

# --- Application URL ---
# Used for share links and deployment previews.
APP_URL=http://localhost:3000

# --- Database: Supabase / PostgreSQL ---
# Required for business data persistence. Server-side Local JSON fallback is disabled.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DB_TIMEOUT_MS=6000
DB_RETRY_ATTEMPTS=2
DB_CIRCUIT_FAILURE_THRESHOLD=3
DB_CIRCUIT_OPEN_MS=30000

# Frontend anon key (optional, only if public client integration is used)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- WhatsApp / Fonnte Integration ---
# Optional. Leave empty to run in WhatsApp Simulation mode.
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_API_TOKEN=your_whatsapp_provider_token
WHATSAPP_PHONE_NUMBER=628xxxxxxxxxx
WHATSAPP_PROVIDER=simulation
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Server ---
# Default port for local dev and Cloud Run. Cloud Run injects PORT automatically.
PORT=8080

# --- Internal Cron / Passive Intelligence Scheduler ---
# Required for secure internal job trigger endpoint:
# POST /api/internal/jobs/passive-intelligence with header x-cron-secret
CRON_SECRET=
PASSIVE_JOB_BATCH_SIZE=25
PASSIVE_JOB_MAX_RUNTIME_MS=240000
